# Safeer Control Configuration Template
# Kopirajte to datoteko v .env in prilagodite lokalne naslove za vaše omrežje:
# cp .env.example .env

# Android TV nastavitve
SAFEER_TV_HOST=192.168.1.100
SAFEER_TV_PORT=5555
SAFEER_TV_NAME=Living Room TV

# Avdio / Soundbar nastavitve (UPnP / DLNA / SOAP)
SAFEER_AUDIO_HOST=192.168.1.101
SAFEER_AUDIO_PORT=49152
SAFEER_AUDIO_NAME=JBL Bar 300

# Omrežna infrastruktura
SAFEER_ROUTER_HOST=192.168.1.1
SAFEER_DNS_HOST=192.168.1.2

# Safeer Control Strežnik
SAFEER_SERVER_HOST=0.0.0.0
SAFEER_SERVER_PORT=8989
SAFEER_ENV=production

# Varnostni ključi in žetoni (po želji za avtentikacijo API)
SAFEER_AUTH_TOKEN=
